generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum IntegrationProvider {
  GOOGLE
  APPLE
  MICROSOFT
  JARVIS
}

enum IntegrationStatus {
  ACTIVE
  NEEDS_AUTH
  ERROR
  DISCONNECTED
}

enum CalendarAccessRole {
  OWNER
  WRITER
  READER
  FREE_BUSY
  NONE
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  displayName String?
  timeZone    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings                 UserSetting[]
  integrations             Integration[]
  calendars                ExternalCalendar[]
  calendarSourceSyncs      CalendarSourceSync[]
  oauthStates              OAuthState[]
  tasks                    Task[]
  areas                    Area[]
  socialContent            SocialContent[]
  financialAccounts        FinancialAccount[]
  bills                    Bill[]
  plaidItems               PlaidItem[]
  recurringBillSuggestions RecurringBillSuggestion[]
  incomeOpportunities      IncomeOpportunity[]
  projects                 Project[]
  automationActionStates   AutomationActionState[]
}

model UserSetting {
  id        String   @id @default(cuid())
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

model Integration {
  id                String              @id @default(cuid())
  provider          IntegrationProvider
  providerAccountId String
  email             String?
  displayName       String?
  status            IntegrationStatus   @default(ACTIVE)
  lastSyncedAt      DateTime?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  credential IntegrationCredential?
  calendars  ExternalCalendar[]

  @@unique([userId, provider, providerAccountId])
  @@index([userId, provider])
  @@index([status])
}

model IntegrationCredential {
  id               String   @id @default(cuid())
  encryptedPayload String
  keyVersion       Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  integrationId String      @unique
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

model ExternalCalendar {
  id            String             @id @default(cuid())
  externalId    String
  name          String
  description   String?
  timeZone      String?
  providerColor String?
  customColor   String?
  accessRole    CalendarAccessRole @default(READER)
  isPrimary     Boolean            @default(false)
  isEnabled     Boolean            @default(true)
  isReadOnly    Boolean            @default(true)
  syncCursor    String?
  lastSyncedAt  DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  events CalendarEvent[]

  @@unique([integrationId, externalId])
  @@index([userId])
  @@index([integrationId, isEnabled])
}

model CalendarEvent {
  id               String      @id @default(cuid())
  externalId       String?
  title            String
  description      String?
  location         String?
  startAt          DateTime
  endAt            DateTime
  isAllDay         Boolean     @default(false)
  status           EventStatus @default(CONFIRMED)
  htmlLink         String?
  etag             String?
  recurrenceRule   String?
  recurringEventId String?
  originalStartAt  DateTime?
  sourceUpdatedAt  DateTime?
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  calendarId String
  calendar   ExternalCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, externalId])
  @@index([calendarId, startAt])
  @@index([startAt])
  @@index([endAt])
  @@index([recurringEventId])
}

model CalendarSourceSync {
  id String @id @default(cuid())

  sourceType    String
  sourceAccount String
  sourceId      String

  calendarId      String
  externalEventId String
  htmlLink        String?

  title   String
  startAt DateTime
  endAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceAccount, sourceId])
  @@index([userId])
  @@index([calendarId])
  @@index([externalEventId])
}

model OAuthState {
  id           String              @id @default(cuid())
  state        String              @unique
  provider     IntegrationProvider
  redirectPath String?
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime            @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  status          String    @default("TODO")
  dueAt           DateTime?
  completedAt     DateTime?
  sortOrder       Int       @default(0)
  manuallyOrdered Boolean   @default(false)
  inTaskList      Boolean   @default(true)

  sourceType      String?
  sourceAccount   String?
  sourceMessageId String?
  sourceThreadId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([dueAt])
  @@index([sourceMessageId])
  @@index([projectId])
  @@index([areaId])
}

model FinancialAccount {
  id           String  @id @default(cuid())
  name         String
  institution  String?
  accountType  String
  isDebt       Boolean @default(false)
  isDebtTarget Boolean @default(false)

  startingBalance Float  @default(0)
  currentBalance  Float  @default(0)
  minimumPayment  Float?
  interestRate    Float?

  promoBalance      Float?
  promoInterestRate Float?
  promoEndsAt       DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plaidItemId    String?
  plaidItem      PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  plaidAccountId String?    @unique
  plaidMask      String?

  bills Bill[]

  @@index([userId])
  @@index([plaidItemId])
  @@index([userId, isDebt])
  @@index([userId, isDebtTarget])
}

model Bill {
  id         String    @id @default(cuid())
  name       String
  amount     Float
  frequency  String    @default("MONTHLY")
  dueDay     Int?
  nextDueAt  DateTime?
  isAutopay  Boolean   @default(false)
  isActive   Boolean   @default(true)
  lastPaidAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([nextDueAt])
  @@index([accountId])
}

model PlaidItem {
  id                   String  @id @default(cuid())
  plaidItemId          String  @unique
  institutionId        String?
  institutionName      String?
  encryptedAccessToken String

  status       String    @default("ACTIVE")
  lastSyncedAt DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accounts FinancialAccount[]

  @@index([userId])
  @@index([status])
}

model RecurringBillSuggestion {
  id                String    @id @default(cuid())
  plaidStreamId     String    @unique
  merchantName      String?
  description       String
  frequency         String
  averageAmount     Float
  lastAmount        Float?
  firstDate         DateTime?
  lastDate          DateTime?
  predictedNextDate DateTime?
  status            String
  reviewStatus      String    @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewStatus])
  @@index([predictedNextDate])
}

model IncomeOpportunity {
  id       String  @id @default(cuid())
  name     String
  category String?
  status   String  @default("RESEARCHING")

  description String?
  notes       String?
  sourceUrl   String?

  startupCost       Float?
  monthlyPotential  Float?
  timeToFirstDollar String?

  effortScore      Int?
  scalabilityScore Int?
  privacyRiskScore Int?
  jarvisScore      Float?

  nextAction String?

  actualIncome Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

model Area {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects Project[]
  tasks    Task[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([userId, isActive])
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?
  status      String  @default("PLANNING")
  progress    Int     @default(0)
  nextAction  String?
  notes       String?

  sourceType String?
  sourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  areaId        String?
  area          Area?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  tasks         Task[]
  socialContent SocialContent[]

  @@unique([userId, sourceType, sourceId])
  @@index([areaId])
  @@index([userId])
  @@index([userId, status])
}

model SocialContent {
  id           String    @id @default(cuid())
  title        String
  platform     String
  status       String    @default("IDEA")
  series       String?
  caption      String?
  hashtags     String?
  publishAt    DateTime?
  publishedUrl String?
  notes        String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, platform])
  @@index([publishAt])
  @@index([projectId])
}

model AutomationActionState {
  id String @id @default(cuid())

  actionId   String
  actionType String
  taskId     String?

  status String @default("ACTIVE")

  snoozedUntil DateTime?
  dismissedAt  DateTime?
  approvedAt   DateTime?
  executedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actionId])
  @@index([userId, status])
  @@index([taskId])
  @@index([snoozedUntil])
}

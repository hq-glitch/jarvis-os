                className="rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
              />

              {isDebt && (
                <>
                  <input
                    type="number"
                    step="0.01"
                    value={minimumPayment}
                    onChange={(event) =>
                      setMinimumPayment(event.target.value)
                    }
                    placeholder="Minimum payment"
                    className="rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                  />

                  <input
                    type="number"
                    step="0.01"
                    value={interestRate}
                    onChange={(event) =>
                      setInterestRate(event.target.value)
                    }
                    placeholder="Standard interest rate %"
                    className="rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                  />
                </>
              )}
            </div>

            <textarea
              value={accountNotes}
              onChange={(event) =>
                setAccountNotes(event.target.value)
              }
              placeholder="Notes (optional)"
              rows={2}
              className="mt-5 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
            />

            <button
              type="submit"
              className="mt-5 rounded-xl bg-[#1E3A34] px-5 py-3 text-sm font-semibold text-white"
            >
              Save account
            </button>
          </form>
        )}

        {showBillForm && (
          <form
            id="add-bill-form"
            onSubmit={createBill}
            className="mt-6 rounded-2xl border border-[#D7D0C5] bg-[#F8F5EF] p-6"
          >
            <h2 className="text-xl font-semibold">
              Add bill
            </h2>

            <div className="mt-5 grid gap-5 md:grid-cols-2">
              <input
                value={billName}
                onChange={(event) =>
                  setBillName(event.target.value)
                }
                placeholder="Bill name"
                className="rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
              />

              <input
                type="number"
                step="0.01"
                value={billAmount}
                onChange={(event) =>
                  setBillAmount(event.target.value)
                }
                placeholder="Amount"
                className="rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
              />

              <select
                value={billFrequency}
                onChange={(event) =>
                  setBillFrequency(event.target.value)
                }
                className="rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
              >
                <option value="MONTHLY">Monthly</option>
                <option value="WEEKLY">Weekly</option>
                <option value="BIWEEKLY">Every 2 weeks</option>
                <option value="QUARTERLY">Quarterly</option>
                <option value="ANNUAL">Annual</option>
                <option value="ONE_TIME">One time</option>
              </select>

              <input
                type="date"
                value={billDueDate}
                onChange={(event) =>
                  setBillDueDate(event.target.value)
                }
                className="rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
              />

              <input
                type="number"
                min="1"
                max="31"
                value={billDueDay}
                onChange={(event) =>
                  setBillDueDay(event.target.value)
                }
                placeholder="Recurring due day"
                className="rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
              />

              <select
                value={billAccountId}
                onChange={(event) =>
                  setBillAccountId(event.target.value)
                }
                className="rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
              >
                <option value="">
                  Payment account (optional)
                </option>
                {accounts
                  .filter((account) => !account.isDebt)
                  .map((account) => (
                    <option
                      key={account.id}
                      value={account.id}
                    >
                      {account.name}
                    </option>
                  ))}
              </select>

              <label className="flex items-center gap-3 rounded-xl border border-[#C7BFB2] bg-white px-4 py-3">
                <input
                  type="checkbox"
                  checked={billAutopay}
                  onChange={(event) =>
                    setBillAutopay(event.target.checked)
                  }
                />
                Autopay
              </label>
            </div>

            <button
              type="submit"
              className="mt-5 rounded-xl bg-[#1E3A34] px-5 py-3 text-sm font-semibold text-white"
            >
              Save bill
            </button>
          </form>
        )}

        {recurringSuggestions.length > 0 && (
          <section className="mt-6 rounded-2xl border border-[#B08D57] bg-[#E9E2D6] p-6">
            <div className="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[#7C5F33]">
                  Jarvis found recurring charges
                </p>

                <h2 className="mt-2 text-2xl font-semibold text-[#1E3A34]">
                  Suggested bills
                </h2>

                <p className="mt-1 text-sm text-[#6F776B]">
                  Review these before adding them to your bill list.
                </p>
              </div>

              <span className="rounded-full bg-[#1E3A34] px-3 py-1 text-xs font-semibold text-white">
                {recurringSuggestions.length} to review
              </span>
            </div>

            <div className="mt-5 grid gap-3 lg:grid-cols-2">
              {recurringSuggestions.map((suggestion) => (
                <article
                  key={suggestion.id}
                  className="rounded-xl border border-[#D7D0C5] bg-[#F8F5EF] p-4"
                >
                  <div className="flex items-start justify-between gap-4">
                    <div className="min-w-0">
                      <p className="truncate font-semibold">
                        {suggestion.merchantName ??
                          suggestion.description}
                      </p>

                      <p className="mt-1 text-xs text-[#7A826E]">
                        {suggestion.frequency}
                        {suggestion.predictedNextDate
                          ? ` · Next ${new Date(
                              suggestion.predictedNextDate,
                            ).toLocaleDateString("en-US", {
                              month: "short",
                              day: "numeric",
                            })}`
                          : ""}
                      </p>
                    </div>

                    <p className="shrink-0 text-lg font-semibold text-[#1E3A34]">
                      {money(
                        suggestion.lastAmount ??
                          suggestion.averageAmount,
                      )}
                    </p>
                  </div>

                  <p className="mt-3 line-clamp-2 text-xs text-[#7A826E]">
                    {suggestion.description}
                  </p>

                  <div className="mt-4 flex flex-wrap gap-2">
                    <button
                      type="button"
                      onClick={() =>
                        void reviewRecurringSuggestion(
                          suggestion.id,
                          "approve",
                        )
                      }
                      className="rounded-lg bg-[#1E3A34] px-4 py-2 text-xs font-semibold text-white"
                    >
                      Add as bill
                    </button>

                    <button
                      type="button"
                      onClick={() =>
                        void reviewRecurringSuggestion(
                          suggestion.id,
                          "ignore",
                        )
                      }
                      className="rounded-lg border border-[#C7BFB2] bg-white px-4 py-2 text-xs font-semibold text-[#6F776B]"
                    >
                      Ignore
                    </button>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {plaidItems.length > 0 && (
          <section className="mt-6 rounded-2xl border border-[#D7D0C5] bg-[#F8F5EF] p-6">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[#B08D57]">
                Connected institutions
              </p>
              <h2 className="mt-2 text-xl font-semibold text-[#1E3A34]">
                Plaid connections
              </h2>
            </div>

            <div className="mt-5 space-y-3">
              {plaidItems.map((item) => (
                <div
                  key={item.id}
                  className="flex flex-col gap-3 rounded-xl border border-[#E1DBD1] bg-[#F3EFE7] p-4 sm:flex-row sm:items-center sm:justify-between"
                >
                  <div>
                    <p className="font-medium">
                      {item.institutionName ?? "Connected bank"}
                    </p>

                    <p className="mt-1 text-xs text-[#7A826E]">
                      Balances synced through Plaid
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={() => void enableBillDetails(item.id)}
                    disabled={isConnectingBank}
                    className="rounded-xl border border-[#B08D57] bg-white px-4 py-2 text-sm font-medium text-[#7C5F33] transition hover:bg-[#F8F5F0] disabled:opacity-50"
                  >
                    Enable bill details
                  </button>
                </div>
              ))}
            </div>
          </section>
        )}

        <section className="mt-6 grid gap-6 xl:grid-cols-3">
          {/* BILLS + DEBT */}
          <div className="rounded-2xl border border-[#D7D0C5] bg-[#F8F5EF] p-6">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[#B08D57]">
                What needs attention
              </p>

              <h2 className="mt-2 text-2xl font-semibold text-[#1E3A34]">
                Bills & Debt
              </h2>
            </div>

            <div className="mt-5 space-y-3">
              {isLoading ? (
                <p className="text-[#6F776B]">
                  Loading bills and debt…
                </p>
              ) : billDebtQueue.length === 0 ? (
                <p className="rounded-xl bg-[#F3EFE7] p-4 text-[#6F776B]">
                  Nothing needs attention right now.
                </p>
              ) : (
                billDebtQueue.map((item) =>
                  renderBillDebtQueueItem(item),
                )
              )}
            </div>
          </div>

          {/* LIQUID ASSETS */}
          <div className="rounded-2xl border border-[#D7D0C5] bg-[#F8F5EF] p-6">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[#B08D57]">
                Available money
              </p>

              <h2 className="mt-2 text-2xl font-semibold text-[#1E3A34]">
                Liquid Assets
              </h2>
            </div>

            <div className="mt-5 space-y-3">
              {isLoading ? (
                <p className="text-[#6F776B]">
                  Loading liquid assets…
                </p>
              ) : liquidAccounts.length === 0 ? (
                <p className="rounded-xl bg-[#F3EFE7] p-4 text-[#6F776B]">
                  Add checking, savings, or another liquid account.
                </p>
              ) : (
                liquidAccounts.map((account) =>
                  renderAccountCard(account),
                )
              )}
            </div>
          </div>

          {/* NON-LIQUID ASSETS */}
          <div className="rounded-2xl border border-[#D7D0C5] bg-[#F8F5EF] p-6">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[#B08D57]">
                Long-term value
              </p>

              <h2 className="mt-2 text-2xl font-semibold text-[#1E3A34]">
                Non-Liquid Assets
              </h2>
            </div>

            <div className="mt-5 space-y-3">
              {isLoading ? (
                <p className="text-[#6F776B]">
                  Loading non-liquid assets…
                </p>
              ) : nonLiquidAccounts.length === 0 ? (
                <p className="rounded-xl bg-[#F3EFE7] p-4 text-[#6F776B]">
                  Add retirement, property, investments, or other assets.
                </p>
              ) : (
                nonLiquidAccounts.map((account) =>
                  renderAccountCard(account),
                )
              )}
            </div>
          </div>
        </section>
      </div>

      {editingBill && (
        <div
          className="fixed inset-0 z-50 flex items-center justify-center bg-black/25 px-4 backdrop-blur-[2px]"
          onClick={() => setEditingBill(null)}
        >
          <div
            className="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-3xl border border-[#D7D0C5] bg-[#F8F5EF] p-6 shadow-2xl"
            onClick={(event) => event.stopPropagation()}
          >
            <div className="flex items-center justify-between">
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.16em] text-[#B08D57]">
                  Bill details
                </p>

                <h2 className="mt-1 text-2xl font-semibold text-[#1E3A34]">
                  Update {editingBill.name}
                </h2>
              </div>

              <button
                type="button"
                onClick={() => setEditingBill(null)}
                className="text-sm text-[#6F776B]"
              >
                Close
              </button>
            </div>

            <div className="mt-5 grid gap-4 md:grid-cols-2">
              <label className="md:col-span-2">
                <span className="text-sm">
                  Bill name
                </span>

                <input
                  value={editBillName}
                  onChange={(event) =>
                    setEditBillName(event.target.value)
                  }
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                />
              </label>

              <label>
                <span className="text-sm">
                  Amount
                </span>

                <input
                  type="number"
                  step="0.01"
                  value={editBillAmount}
                  onChange={(event) =>
                    setEditBillAmount(event.target.value)
                  }
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                />
              </label>

              <label>
                <span className="text-sm">
                  Frequency
                </span>

                <select
                  value={editBillFrequency}
                  onChange={(event) =>
                    setEditBillFrequency(event.target.value)
                  }
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                >
                  <option value="MONTHLY">Monthly</option>
                  <option value="WEEKLY">Weekly</option>
                  <option value="BIWEEKLY">Every 2 weeks</option>
                  <option value="QUARTERLY">Quarterly</option>
                  <option value="ANNUAL">Annual</option>
                  <option value="ONE_TIME">One time</option>
                </select>
              </label>

              <label>
                <span className="text-sm">
                  Next due date
                </span>

                <input
                  type="date"
                  value={editBillDueDate}
                  onChange={(event) =>
                    setEditBillDueDate(event.target.value)
                  }
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                />
              </label>

              <label>
                <span className="text-sm">
                  Recurring due day
                </span>

                <input
                  type="number"
                  min="1"
                  max="31"
                  value={editBillDueDay}
                  onChange={(event) =>
                    setEditBillDueDay(event.target.value)
                  }
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                />
              </label>

              <label className="md:col-span-2">
                <span className="text-sm">
                  Payment account
                </span>

                <select
                  value={editBillAccountId}
                  onChange={(event) =>
                    setEditBillAccountId(event.target.value)
                  }
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                >
                  <option value="">
                    No linked account
                  </option>

                  {accounts.map((account) => (
                    <option
                      key={account.id}
                      value={account.id}
                    >
                      {account.name}
                    </option>
                  ))}
                </select>
              </label>

              <label className="flex items-center gap-3 rounded-xl border border-[#C7BFB2] bg-white px-4 py-3">
                <input
                  type="checkbox"
                  checked={editBillAutopay}
                  onChange={(event) =>
                    setEditBillAutopay(
                      event.target.checked,
                    )
                  }
                />

                <span className="text-sm">
                  Autopay
                </span>
              </label>

              <label className="flex items-center gap-3 rounded-xl border border-[#C7BFB2] bg-white px-4 py-3">
                <input
                  type="checkbox"
                  checked={editBillActive}
                  onChange={(event) =>
                    setEditBillActive(
                      event.target.checked,
                    )
                  }
                />

                <span className="text-sm">
                  Active bill
                </span>
              </label>

              <label className="md:col-span-2">
                <span className="text-sm">
                  Notes
                </span>

                <textarea
                  value={editBillNotes}
                  onChange={(event) =>
                    setEditBillNotes(event.target.value)
                  }
                  rows={3}
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                />
              </label>
            </div>

            <button
              type="button"
              onClick={() => void saveBillChanges()}
              className="mt-6 w-full rounded-xl bg-[#1E3A34] px-5 py-3 text-sm font-semibold text-white"
            >
              Save changes
            </button>
          </div>
        </div>
      )}

      {editingAccount && (
        <div
          className="fixed inset-0 z-50 flex items-center justify-center bg-black/25 px-4 backdrop-blur-[2px]"
          onClick={() => setEditingAccount(null)}
        >
          <div
            className="w-full max-w-xl rounded-3xl border border-[#D7D0C5] bg-[#F8F5EF] p-6 shadow-2xl"
            onClick={(event) => event.stopPropagation()}
          >
            <div className="flex items-center justify-between">
              <h2 className="text-2xl font-semibold">
                Update {editingAccount.name}
              </h2>

              <button
                type="button"
                onClick={() => setEditingAccount(null)}
                className="text-sm text-[#6F776B]"
              >
                Close
              </button>
            </div>

            <div className="mt-5 grid gap-4">
              <label>
                <span className="text-sm">
                  Account type
                </span>

                <select
                  value={editAccountType}
                  onChange={(event) =>
                    setEditAccountType(event.target.value)
                  }
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                >
                  <option value="CHECKING">Checking</option>
                  <option value="SAVINGS">Savings</option>
                  <option value="INVESTMENT">Investment</option>
                  <option value="RETIREMENT">Retirement</option>
                  <option value="REAL_ESTATE">Real estate</option>
                  <option value="VEHICLE">Vehicle</option>
                  <option value="OTHER_ASSET">Other asset</option>
                  <option value="CREDIT_CARD">Credit card</option>
                  <option value="LOAN">Loan</option>
                  <option value="MORTGAGE">Mortgage</option>
                  <option value="TAX_DEBT">Tax debt</option>
                  <option value="OTHER_DEBT">Other debt</option>
                  <option value="OTHER">Other — legacy</option>
                </select>
              </label>

              <label>
                <span className="text-sm">
                  Current balance
                </span>
                <input
                  type="number"
                  step="0.01"
                  value={editCurrentBalance}
                  onChange={(event) =>
                    setEditCurrentBalance(
                      event.target.value,
                    )
                  }
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                />
              </label>

              <label>
                <span className="text-sm">
                  Starting balance
                </span>
                <input
                  type="number"
                  step="0.01"
                  value={editStartingBalance}
                  onChange={(event) =>
                    setEditStartingBalance(
                      event.target.value,
                    )
                  }
                  className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                />
              </label>

              {editingAccount.isDebt && (
                <>
                  <label>
                    <span className="text-sm">
                      Minimum payment
                    </span>
                    <input
                      type="number"
                      step="0.01"
                      value={editMinimumPayment}
                      onChange={(event) =>
                        setEditMinimumPayment(
                          event.target.value,
                        )
                      }
                      className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                    />
                  </label>

                  <label>
                    <span className="text-sm">
                      Standard interest rate %
                    </span>
                    <input
                      type="number"
                      step="0.01"
                      value={editInterestRate}
                      onChange={(event) =>
                        setEditInterestRate(
                          event.target.value,
                        )
                      }
                      className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                    />
                  </label>

                  <div className="rounded-2xl border border-[#D7D0C5] bg-white/60 p-4">
                    <p className="text-sm font-semibold text-[#1E3A34]">
                      Promotional balance
                    </p>

                    <div className="mt-4 grid gap-4 md:grid-cols-2">
                      <label>
                        <span className="text-sm">Promo balance</span>
                        <input
                          type="number"
                          step="0.01"
                          value={editPromoBalance}
                          onChange={(event) =>
                            setEditPromoBalance(event.target.value)
                          }
                          className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                        />
                      </label>

                      <label>
                        <span className="text-sm">Promo APR %</span>
                        <input
                          type="number"
                          step="0.01"
                          value={editPromoInterestRate}
                          onChange={(event) =>
                            setEditPromoInterestRate(event.target.value)
                          }
                          className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                        />
                      </label>

                      <label className="md:col-span-2">
                        <span className="text-sm">Promo end date</span>
                        <input
                          type="date"
                          value={editPromoEndsAt}
                          onChange={(event) =>
                            setEditPromoEndsAt(event.target.value)
                          }
                          className="mt-2 w-full rounded-xl border border-[#C7BFB2] bg-white px-4 py-3"
                        />
                      </label>
                    </div>
                  </div>
                </>
              )}
            </div>

            <button
              type="button"
              onClick={() => void saveAccountChanges()}
              className="mt-6 w-full rounded-xl bg-[#1E3A34] px-5 py-3 text-sm font-semibold text-white"
            >
              Save changes
            </button>
          </div>
        </div>
      )}
    </main>
  );
}

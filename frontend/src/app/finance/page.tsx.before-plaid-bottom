  type BillDebtQueueItem =
    | {
        kind: "bill";
        key: string;
        bill: Bill;
        isPaid: boolean;
        isMonitoring: boolean;
        dueTime: number;
        dueDay: number;
      }
    | {
        kind: "debt";
        key: string;
        account: FinancialAccount;
        bill: Bill | null;
        isPaid: boolean;
        isMonitoring: boolean;
        dueTime: number;
        dueDay: number;
      };

  function billDueTime(bill: Bill | null) {
    if (!bill?.nextDueAt) {
      return Number.POSITIVE_INFINITY;
    }

    const value = new Date(bill.nextDueAt).getTime();

    return Number.isNaN(value)
      ? Number.POSITIVE_INFINITY
      : value;
  }

  const debtAccountsById = new Map(
    accounts
      .filter((account) => isDebtAccount(account))
      .map((account) => [account.id, account]),
  );

  const linkedDebtBillIds = new Set(
    bills
      .filter(
        (bill) =>
          bill.accountId &&
          debtAccountsById.has(bill.accountId),
      )
      .map((bill) => bill.id),
  );

  const debtQueueItems: BillDebtQueueItem[] = accounts
    .filter((account) => isDebtAccount(account))
    .map((account) => {
      const linkedBill =
        bills.find(
          (bill) => bill.accountId === account.id,
        ) ?? null;

      const zeroBalance =
        Math.abs(account.currentBalance) <= 0.005;

      const hasActualBillDue =
        linkedBill !== null &&
        linkedBill.amount > 0;

      return {
        kind: "debt" as const,
        key: `debt-${account.id}`,
        account,
        bill: linkedBill,
        isPaid: linkedBill
          ? isBillPaidThisMonth(linkedBill)
          : false,
        isMonitoring:
          zeroBalance && !hasActualBillDue,
        dueTime: billDueTime(linkedBill),
        dueDay: linkedBill?.dueDay ?? 99,
      };
    });

  const standaloneBillItems: BillDebtQueueItem[] = bills
    .filter(
      (bill) => !linkedDebtBillIds.has(bill.id),
    )
    .map((bill) => ({
      kind: "bill" as const,
      key: `bill-${bill.id}`,
      bill,
      isPaid: isBillPaidThisMonth(bill),
      isMonitoring: false,
      dueTime: billDueTime(bill),
      dueDay: bill.dueDay ?? 99,
    }));

  const billDebtQueue = [
    ...standaloneBillItems,
    ...debtQueueItems,
  ].sort((a, b) => {
    // Zero-balance monitoring items always live at bottom.
    if (a.isMonitoring !== b.isMonitoring) {
      return a.isMonitoring ? 1 : -1;
    }

    // Paid items move below unpaid items.
    if (a.isPaid !== b.isPaid) {
      return a.isPaid ? 1 : -1;
    }

    // Then sort by actual next due date.
    if (a.dueTime !== b.dueTime) {
      return a.dueTime - b.dueTime;
    }

    // Then recurring due day.
    if (a.dueDay !== b.dueDay) {
      return a.dueDay - b.dueDay;
    }

    return a.key.localeCompare(b.key);
  });


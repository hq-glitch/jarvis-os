"use client";

import { FormEvent, useCallback, useEffect, useMemo, useState } from "react";
import { usePlaidLink } from "react-plaid-link";

type FinancialAccount = {
  id: string;
  name: string;
  institution: string | null;
  accountType: string;
  isDebt: boolean;
  isDebtTarget: boolean;
  startingBalance: number;
  currentBalance: number;
  minimumPayment: number | null;
  interestRate: number | null;
  promoBalance: number | null;
  promoInterestRate: number | null;
  promoEndsAt: string | null;
  notes: string | null;
  plaidAccountId: string | null;
  plaidMask: string | null;
};

type PlaidItem = {
  id: string;
  institutionName: string | null;
  institutionId: string | null;
  lastSyncedAt: string | null;
  lastError: string | null;
};

type RecurringBillSuggestion = {
  id: string;
  plaidStreamId: string;
  merchantName: string | null;
  description: string;
  frequency: string;
  averageAmount: number;
  lastAmount: number | null;
  firstDate: string | null;
  lastDate: string | null;
  predictedNextDate: string | null;
  status: string;
  reviewStatus: string;
};

type Bill = {
  id: string;
  name: string;
  amount: number;
  frequency: string;
  dueDay: number | null;
  nextDueAt: string | null;
  isAutopay: boolean;
  isActive: boolean;
  lastPaidAt: string | null;
  notes: string | null;
  accountId: string | null;
  account: FinancialAccount | null;
};

function money(value: number) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(value);
}

function accountTypeLabel(value: string) {
  const labels: Record<string, string> = {
    CHECKING: "Checking",
    SAVINGS: "Savings",
    INVESTMENT: "Investment",
    RETIREMENT: "Retirement",
    REAL_ESTATE: "Real Estate",
    VEHICLE: "Vehicle",
    OTHER_ASSET: "Other Asset",
    CREDIT_CARD: "Credit Card",
    LOAN: "Loan",
    MORTGAGE: "Mortgage",
    TAX_DEBT: "Tax Debt",
    OTHER_DEBT: "Other Debt",
    OTHER: "Other",
  };

  return labels[value] ?? value.replaceAll("_", " ");
}

function percent(value: number) {
  return `${Math.max(0, Math.min(100, value)).toFixed(1)}%`;
}

function dueLabel(value: string | null, dueDay: number | null) {
  if (value) {
    const date = new Date(value);

    if (!Number.isNaN(date.getTime())) {
      return date.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
      });
    }
  }

  if (dueDay) {
    return `Day ${dueDay}`;
  }

  return "No due date";
}

export default function FinancePage() {
  const [accounts, setAccounts] = useState<FinancialAccount[]>([]);
  const [bills, setBills] = useState<Bill[]>([]);
  const [plaidItems, setPlaidItems] = useState<PlaidItem[]>([]);
  const [recurringSuggestions, setRecurringSuggestions] =
    useState<RecurringBillSuggestion[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const [plaidLinkToken, setPlaidLinkToken] =
    useState<string | null>(null);
  const [isConnectingBank, setIsConnectingBank] =
    useState(false);
  const [plaidMode, setPlaidMode] =
    useState<"connect" | "update">("connect");

  const [showAccountForm, setShowAccountForm] = useState(false);
  const [showBillForm, setShowBillForm] = useState(false);

  const [accountName, setAccountName] = useState("");
  const [institution, setInstitution] = useState("");
  const [accountType, setAccountType] = useState("CHECKING");
  const [isDebt, setIsDebt] = useState(false);
  const [startingBalance, setStartingBalance] = useState("");
  const [currentBalance, setCurrentBalance] = useState("");
  const [minimumPayment, setMinimumPayment] = useState("");
  const [interestRate, setInterestRate] = useState("");
  const [accountNotes, setAccountNotes] = useState("");

  const [billName, setBillName] = useState("");
  const [billAmount, setBillAmount] = useState("");
  const [billFrequency, setBillFrequency] = useState("MONTHLY");
  const [billNotes, setBillNotes] = useState("");
  const [billDueDate, setBillDueDate] = useState("");
  const [billDueDay, setBillDueDay] = useState("");
  const [billAutopay, setBillAutopay] = useState(false);
  const [billAccountId, setBillAccountId] = useState("");

  const [editingAccount, setEditingAccount] =
    useState<FinancialAccount | null>(null);
  const [editAccountType, setEditAccountType] = useState("");
  const [editCurrentBalance, setEditCurrentBalance] = useState("");
  const [editStartingBalance, setEditStartingBalance] = useState("");
  const [editMinimumPayment, setEditMinimumPayment] = useState("");
  const [editInterestRate, setEditInterestRate] = useState("");
  const [editPromoBalance, setEditPromoBalance] = useState("");
  const [editPromoInterestRate, setEditPromoInterestRate] = useState("");
  const [editPromoEndsAt, setEditPromoEndsAt] = useState("");

  const [editingBill, setEditingBill] = useState<Bill | null>(null);
  const [editBillName, setEditBillName] = useState("");
  const [editBillAmount, setEditBillAmount] = useState("");
  const [editBillFrequency, setEditBillFrequency] = useState("MONTHLY");
  const [editBillDueDate, setEditBillDueDate] = useState("");
  const [editBillDueDay, setEditBillDueDay] = useState("");
  const [editBillAutopay, setEditBillAutopay] = useState(false);
  const [editBillAccountId, setEditBillAccountId] = useState("");
  const [editBillNotes, setEditBillNotes] = useState("");
  const [editBillActive, setEditBillActive] = useState(true);

  const handlePlaidSuccess = useCallback(
    async (
      publicToken: string | null,
      metadata: {
        institution?: {
          institution_id: string;
          name: string;
        } | null;
      },
    ) => {
      if (!publicToken) {
        setError("Plaid did not return a public token.");
        return;
      }

      setIsConnectingBank(true);
      setError(null);

      if (plaidMode === "update") {
        setPlaidLinkToken(null);
        setPlaidMode("connect");
        setIsConnectingBank(false);
        return;
      }

      try {
        const response = await fetch(
          "/api/plaid/exchange-public-token",
          {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              publicToken,
              institutionId:
                metadata.institution?.institution_id ?? null,
              institutionName:
                metadata.institution?.name ?? null,
            }),
          },
        );

        const data = (await response.json()) as {
          error?: string;
        };

        if (!response.ok) {
          throw new Error(
            data.error ?? "Unable to connect bank.",
          );
        }

        setPlaidLinkToken(null);
        await loadFinance();
      } catch (connectError) {
        setError(
          connectError instanceof Error
            ? connectError.message
            : "Unable to connect bank.",
        );
      } finally {
        setIsConnectingBank(false);
      }
    },
    [plaidMode],
  );

  const {
    open: openPlaid,
    ready: plaidReady,
  } = usePlaidLink({
    token: plaidLinkToken,
    onSuccess: handlePlaidSuccess,
    onExit: () => {
      setIsConnectingBank(false);
    },
  });

  async function enableBillDetails(itemId: string) {
    setError(null);
    setIsConnectingBank(true);
    setPlaidMode("update");

    try {
      const response = await fetch(
        "/api/plaid/create-update-link-token",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            itemId,
          }),
        },
      );

      const data = (await response.json()) as {
        linkToken?: string;
        error?: string;
      };

      if (!response.ok || !data.linkToken) {
        throw new Error(
          data.error ?? "Unable to enable bill details.",
        );
      }

      setPlaidLinkToken(data.linkToken);
    } catch (consentError) {
      setPlaidMode("connect");
      setIsConnectingBank(false);

      setError(
        consentError instanceof Error
          ? consentError.message
          : "Unable to enable bill details.",
      );
    }
  }

  async function connectBank() {
    setError(null);
    setIsConnectingBank(true);
    setPlaidMode("connect");

    try {
      const response = await fetch(
        "/api/plaid/create-link-token",
        {
          method: "POST",
        },
      );

      const data = (await response.json()) as {
        linkToken?: string;
        error?: string;
      };

      if (!response.ok || !data.linkToken) {
        throw new Error(
          data.error ?? "Unable to start Plaid Link.",
        );
      }

      setPlaidLinkToken(data.linkToken);
    } catch (connectError) {
      setError(
        connectError instanceof Error
          ? connectError.message
          : "Unable to start Plaid Link.",
      );
      setIsConnectingBank(false);
    }
  }

  useEffect(() => {
    if (plaidLinkToken && plaidReady) {
      openPlaid();
      setIsConnectingBank(false);
    }
  }, [plaidLinkToken, plaidReady, openPlaid]);

  async function loadFinance() {
    setIsLoading(true);
    setError(null);

    try {
      try {
        await Promise.all([
          fetch("/api/plaid/sync-balances", {
            method: "POST",
            cache: "no-store",
          }),
          fetch("/api/plaid/sync-liabilities", {
            method: "POST",
            cache: "no-store",
          }),
        ]);
      } catch {
        // Keep showing the last saved finance data if
        // Plaid is temporarily unavailable.
      }

      const response = await fetch("/api/finance", {
        cache: "no-store",
      });

      if (!response.ok) {
        throw new Error("Unable to load finance data.");
      }

      const data = (await response.json()) as {
        accounts: FinancialAccount[];
        bills: Bill[];
        plaidItems: PlaidItem[];
        recurringSuggestions: RecurringBillSuggestion[];
      };

      setAccounts(data.accounts ?? []);
      setBills(data.bills ?? []);
      setPlaidItems(data.plaidItems ?? []);
      setRecurringSuggestions(
        data.recurringSuggestions ?? [],
      );
    } catch (loadError) {
      setError(
        loadError instanceof Error
          ? loadError.message
          : "Unable to load finance data.",
      );
    } finally {
      setIsLoading(false);
    }
  }

  useEffect(() => {
    void loadFinance();
  }, []);

  const debtSummary = useMemo(() => {
    const debts = accounts.filter((account) => account.isDebt);

    const startingDebt = debts.reduce(
      (total, account) => total + account.startingBalance,
      0,
    );

    const currentDebt = debts.reduce(
      (total, account) => total + account.currentBalance,
      0,
    );

    const paidOff = Math.max(0, startingDebt - currentDebt);

    const progress =
      startingDebt > 0 ? (paidOff / startingDebt) * 100 : 0;

    const target =
      debts.find((account) => account.isDebtTarget) ?? null;

    const targetPaidOff = target
      ? Math.max(0, target.startingBalance - target.currentBalance)
      : 0;

    const targetProgress =
      target && target.startingBalance > 0
        ? (targetPaidOff / target.startingBalance) * 100
        : 0;

    return {
      debts,
      startingDebt,
      currentDebt,
      paidOff,
      progress,
      target,
      targetPaidOff,
      targetProgress,
    };
  }, [accounts]);

  const assetSummary = useMemo(() => {
    const assets = accounts.filter((account) => !account.isDebt);

    const liquidAssets = assets.filter((account) =>
      ["CHECKING", "SAVINGS"].includes(account.accountType),
    );

    const nonLiquidAssets = assets.filter(
      (account) =>
        !["CHECKING", "SAVINGS"].includes(account.accountType),
    );

    const liquidTotal = liquidAssets.reduce(
      (total, account) => total + Math.max(0, account.currentBalance),
      0,
    );

    const nonLiquidTotal = nonLiquidAssets.reduce(
      (total, account) => total + Math.max(0, account.currentBalance),
      0,
    );

    const totalAssets = liquidTotal + nonLiquidTotal;

    const netWorth = totalAssets - debtSummary.currentDebt;

    const debtToAssetsRatio =
      totalAssets > 0
        ? (debtSummary.currentDebt / totalAssets) * 100
        : 0;

    return {
      assets,
      liquidAssets,
      nonLiquidAssets,
      liquidTotal,
      nonLiquidTotal,
      totalAssets,
      netWorth,
      debtToAssetsRatio,
    };
  }, [accounts, debtSummary.currentDebt]);

  function isBillPaidThisMonth(bill: Bill) {
    if (!bill.lastPaidAt) {
      return false;
    }

    const paidDate = new Date(bill.lastPaidAt);
    const now = new Date();

    if (Number.isNaN(paidDate.getTime())) {
      return false;
    }

    return (
      paidDate.getFullYear() === now.getFullYear() &&
      paidDate.getMonth() === now.getMonth()
    );
  }

  const upcomingBills = useMemo(() => {
    return [...bills].sort((a, b) => {
      const aPaid = isBillPaidThisMonth(a);
      const bPaid = isBillPaidThisMonth(b);

      if (aPaid !== bPaid) {
        return aPaid ? 1 : -1;
      }

      if (a.nextDueAt && b.nextDueAt) {
        return (
          new Date(a.nextDueAt).getTime() -
          new Date(b.nextDueAt).getTime()
        );
      }

      if (a.nextDueAt) {
        return -1;
      }

      if (b.nextDueAt) {
        return 1;
      }

      return (a.dueDay ?? 99) - (b.dueDay ?? 99);
    });
  }, [bills]);

  async function toggleBillPaid(bill: Bill) {
    setError(null);

    const currentlyPaid = isBillPaidThisMonth(bill);

    try {
      const response = await fetch("/api/finance", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          type: "bill",
          id: bill.id,
          lastPaidAt: currentlyPaid
            ? null
            : new Date().toISOString(),
        }),
      });

      if (!response.ok) {
        throw new Error("Unable to update bill payment status.");
      }

      await loadFinance();
    } catch (paymentError) {
      setError(
        paymentError instanceof Error
          ? paymentError.message
          : "Unable to update bill payment status.",
      );
    }
  }

  async function reviewRecurringSuggestion(
    suggestionId: string,
    action: "approve" | "ignore",
  ) {
    setError(null);

    try {
      const response = await fetch(
        "/api/finance/recurring-suggestions",
        {
          method: "PATCH",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            id: suggestionId,
            action,
          }),
        },
      );

      const data = (await response.json()) as {
        error?: string;
      };

      if (!response.ok) {
        throw new Error(
          data.error ??
            "Unable to review recurring charge.",
        );
      }

      await loadFinance();
    } catch (reviewError) {
      setError(
        reviewError instanceof Error
          ? reviewError.message
          : "Unable to review recurring charge.",
      );
    }
  }

  async function createAccount(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    if (!accountName.trim()) {
      return;
    }

    try {
      const response = await fetch("/api/finance", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          type: "account",
          name: accountName.trim(),
          institution: institution.trim() || null,
          accountType,
          isDebt: [
            "CREDIT_CARD",
            "LOAN",
            "MORTGAGE",
            "TAX_DEBT",
            "OTHER_DEBT",
          ].includes(accountType),
          startingBalance: Number(startingBalance || 0),
          currentBalance: Number(currentBalance || 0),
          minimumPayment: minimumPayment
            ? Number(minimumPayment)
            : null,
          interestRate: interestRate
            ? Number(interestRate)
            : null,
          notes: accountNotes.trim() || null,
        }),
      });

      if (!response.ok) {
        const data = (await response.json()) as {
          error?: string;
        };

        throw new Error(
          data.error ?? "Unable to create account.",
        );
      }

      setAccountName("");
      setInstitution("");
      setAccountType("CHECKING");
      setIsDebt(false);
      setStartingBalance("");
      setCurrentBalance("");
      setMinimumPayment("");
      setInterestRate("");
      setAccountNotes("");
      setShowAccountForm(false);

      await loadFinance();
    } catch (createError) {
      setError(
        createError instanceof Error
          ? createError.message
          : "Unable to create account.",
      );
    }
  }

  async function createBill(
    event: FormEvent<HTMLFormElement>,
  ) {
    event.preventDefault();

    if (!billName.trim() || !billAmount) {
      return;
    }

    try {
      const response = await fetch("/api/finance", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          type: "bill",
          name: billName.trim(),
          amount: Number(billAmount),
          frequency: billFrequency,
          dueDay: billDueDay ? Number(billDueDay) : null,
          nextDueAt: billDueDate
            ? new Date(`${billDueDate}T12:00:00`).toISOString()
            : null,
          isAutopay: billAutopay,
          accountId: billAccountId || null,
          notes: billNotes.trim() || null,
        }),
      });

      if (!response.ok) {
        const data = (await response.json()) as {
          error?: string;
        };

        throw new Error(
          data.error ?? "Unable to create bill.",
        );
      }

      setBillName("");
      setBillAmount("");
      setBillFrequency("MONTHLY");
      setBillNotes("");
      setBillDueDate("");
      setBillDueDay("");
      setBillAutopay(false);
      setBillAccountId("");
      setShowBillForm(false);

      await loadFinance();
    } catch (createError) {
      setError(
        createError instanceof Error
          ? createError.message
          : "Unable to create bill.",
      );
    }
  }

  async function setDebtTarget(account: FinancialAccount) {
    try {
      const response = await fetch("/api/finance", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          type: "account",
          id: account.id,
          isDebtTarget: true,
        }),
      });

      if (!response.ok) {
        throw new Error("Unable to set debt target.");
      }

      await loadFinance();
    } catch (targetError) {
      setError(
        targetError instanceof Error
          ? targetError.message
          : "Unable to set debt target.",
      );
    }
  }

  function openAccountEditor(account: FinancialAccount) {
    setEditingAccount(account);
    setEditAccountType(account.accountType);
    setEditCurrentBalance(String(account.currentBalance));
    setEditStartingBalance(String(account.startingBalance));
    setEditMinimumPayment(
      account.minimumPayment !== null
        ? String(account.minimumPayment)
        : "",
    );
    setEditInterestRate(
      account.interestRate !== null
        ? String(account.interestRate)
        : "",
    );

    setEditPromoBalance(
      account.promoBalance !== null
        ? String(account.promoBalance)
        : "",
    );

    setEditPromoInterestRate(
      account.promoInterestRate !== null
        ? String(account.promoInterestRate)
        : "",
    );

    setEditPromoEndsAt(
      account.promoEndsAt
        ? account.promoEndsAt.slice(0, 10)
        : "",
    );
  }

  async function saveAccountChanges() {
    if (!editingAccount) {
      return;
    }

    try {
      const response = await fetch("/api/finance", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          type: "account",
          id: editingAccount.id,
          accountType: editAccountType,
          startingBalance: Number(editStartingBalance || 0),
          currentBalance: Number(editCurrentBalance || 0),
          minimumPayment: editMinimumPayment
            ? Number(editMinimumPayment)
            : null,
          interestRate: editInterestRate
            ? Number(editInterestRate)
            : null,
          promoBalance: editPromoBalance
            ? Number(editPromoBalance)
            : null,
          promoInterestRate: editPromoInterestRate
            ? Number(editPromoInterestRate)
            : null,
          promoEndsAt: editPromoEndsAt || null,
        }),
      });

      if (!response.ok) {
        throw new Error("Unable to update account.");
      }

      setEditingAccount(null);
      await loadFinance();
    } catch (saveError) {
      setError(
        saveError instanceof Error
          ? saveError.message
          : "Unable to update account.",
      );
    }
  }


  function openBillEditor(bill: Bill) {
    setEditingBill(bill);
    setEditBillName(bill.name);
    setEditBillAmount(String(bill.amount));
    setEditBillFrequency(bill.frequency || "MONTHLY");

    setEditBillDueDate(
      bill.nextDueAt
        ? bill.nextDueAt.slice(0, 10)
        : "",
    );

    setEditBillDueDay(
      bill.dueDay !== null
        ? String(bill.dueDay)
        : "",
    );

    setEditBillAutopay(bill.isAutopay);
    setEditBillAccountId(bill.accountId ?? "");
    setEditBillNotes(bill.notes ?? "");
    setEditBillActive(bill.isActive);
  }

  async function saveBillChanges() {
    if (!editingBill) {
      return;
    }

    if (!editBillName.trim() || !editBillAmount) {
      setError("Bill name and amount are required.");
      return;
    }

    setError(null);

    try {
      const response = await fetch("/api/finance", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          type: "bill",
          id: editingBill.id,
          name: editBillName.trim(),
          amount: Number(editBillAmount),
          frequency: editBillFrequency,
          dueDay: editBillDueDay
            ? Number(editBillDueDay)
            : null,
          nextDueAt: editBillDueDate
            ? new Date(
                `${editBillDueDate}T12:00:00`,
              ).toISOString()
            : null,
          isAutopay: editBillAutopay,
          isActive: editBillActive,
          accountId: editBillAccountId || null,
          notes: editBillNotes.trim() || null,
        }),
      });

      if (!response.ok) {
        const data = (await response.json()) as {
          error?: string;
        };

        throw new Error(
          data.error ?? "Unable to update bill.",
        );
      }

      setEditingBill(null);
      await loadFinance();
    } catch (saveError) {
      setError(
        saveError instanceof Error
          ? saveError.message
          : "Unable to update bill.",
      );
    }
  }

  const debtAccountTypes = [
    "CREDIT_CARD",
    "LOAN",
    "MORTGAGE",
    "TAX_DEBT",
    "OTHER_DEBT",
  ];

  const liquidAccountTypes = [
    "CHECKING",
    "SAVINGS",
  ];

  const isDebtAccount = (account: FinancialAccount) =>
    account.isDebt || debtAccountTypes.includes(account.accountType);

  const activeDebtAccounts = accounts.filter(
    (account) =>
      isDebtAccount(account) &&
      Math.abs(account.currentBalance) > 0.005,
  );

  const monitoringDebtAccounts = accounts.filter(
    (account) =>
      isDebtAccount(account) &&
      Math.abs(account.currentBalance) <= 0.005,
  );

  const liquidAccounts = accounts.filter(
    (account) =>
      !isDebtAccount(account) &&
      liquidAccountTypes.includes(account.accountType),
  );

  const nonLiquidAccounts = accounts.filter(
    (account) =>
      !isDebtAccount(account) &&
      !liquidAccountTypes.includes(account.accountType),
  );

  function renderAccountCard(account: FinancialAccount) {
    return (
      <article
        key={account.id}
        className="rounded-xl border border-[#E1DBD1] bg-[#F3EFE7] p-4"
      >
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p className="font-semibold">
              {account.name}
            </p>

            <p className="mt-1 text-xs text-[#7A826E]">

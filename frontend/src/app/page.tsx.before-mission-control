"use client";

import { useEffect, useMemo, useState } from "react";

type ImportedEvent = {
  id: string;
  title: string;
  startAt: string;
  endAt: string;
  isAllDay: boolean;
  notes: string;
  location: string | null;
  htmlLink: string | null;
  calendarName: string;
  calendarColor: string | null;
  accountEmail: string;
};

type ConnectionError = {
  accountEmail: string | null;
  calendarName?: string;
  error: string;
};

const projects = [
  { name: "Jarvis OS", progress: 70 },
  { name: "Pepperdine", progress: 20 },
  { name: "Rouke Ranch", progress: 80 },
];

function formatEventTime(event: ImportedEvent) {
  if (event.isAllDay) {
    return "All day";
  }

  return new Date(event.startAt).toLocaleTimeString("en-US", {
    hour: "numeric",
    minute: "2-digit",
  });
}

export default function Home() {
  const [events, setEvents] = useState<ImportedEvent[]>([]);
  const [connectionErrors, setConnectionErrors] = useState<ConnectionError[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [greeting, setGreeting] = useState("Welcome back, Sarah.");

  useEffect(() => {
    const hour = new Date().getHours();

    if (hour < 12) {
      setGreeting("Good morning, Sarah.");
    } else if (hour < 17) {
      setGreeting("Good afternoon, Sarah.");
    } else {
      setGreeting("Good evening, Sarah.");
    }
  }, []);

  useEffect(() => {
    let cancelled = false;

    async function loadDashboard() {
      try {
        const response = await fetch("/api/events", {
          cache: "no-store",
        });

        if (!response.ok) {
          throw new Error("Unable to load dashboard calendar data.");
        }

        const data = (await response.json()) as {
          events: ImportedEvent[];
          connectionErrors?: ConnectionError[];
        };

        if (!cancelled) {
          setEvents(data.events);
          setConnectionErrors(data.connectionErrors ?? []);
        }
      } catch (error) {
        console.error(
          error instanceof Error
            ? error.message
            : "Unable to load dashboard data.",
        );
      } finally {
        if (!cancelled) {
          setIsLoading(false);
        }
      }
    }

    void loadDashboard();

    return () => {
      cancelled = true;
    };
  }, []);

  const dashboardData = useMemo(() => {
    const now = new Date();
    const startOfToday = new Date(
      now.getFullYear(),
      now.getMonth(),
      now.getDate(),
    );
    const startOfTomorrow = new Date(startOfToday);
    startOfTomorrow.setDate(startOfTomorrow.getDate() + 1);

    const sevenDaysFromNow = new Date(startOfToday);
    sevenDaysFromNow.setDate(sevenDaysFromNow.getDate() + 7);

    const todayEvents = events.filter((event) => {
      const start = new Date(event.startAt);
      return start >= startOfToday && start < startOfTomorrow;
    });

    const upcomingEvents = events.filter((event) => {
      const start = new Date(event.startAt);
      return start >= startOfToday && start < sevenDaysFromNow;
    });

    const calendarCount = new Set(
      events.map(
        (event) => `${event.accountEmail}:${event.calendarName}`,
      ),
    ).size;

    return {
      todayEvents,
      upcomingEvents,
      calendarCount,
    };
  }, [events]);

  const recommendation = useMemo(() => {
    const count = dashboardData.todayEvents.length;

    if (isLoading) {
      return {
        title: "Reviewing today’s priorities.",
        message: "Jarvis is checking your connected calendars.",
      };
    }

    if (connectionErrors.length > 0) {
      return {
        title: "One connection needs attention.",
        message:
          "Open Manage Calendars and reconnect the account showing an authorization error.",
      };
    }

    if (count === 0) {
      return {
        title: "Protect one focused hour.",
        message:
          "Your calendar is open today. Choose one meaningful task and give it your full attention.",
      };
    }

    if (count >= 6) {
      return {
        title: "Protect your energy today.",
        message:
          "Your calendar is full. Focus on the essential commitments and leave breathing room between them.",
      };
    }

    return {
      title: "Your day has room to breathe.",
      message:
        "Handle your scheduled commitments, then protect one focused block for Jarvis or Rouke Ranch.",
    };
  }, [
    connectionErrors.length,
    dashboardData.todayEvents.length,
    isLoading,
  ]);

  return (
    <main className="min-h-screen bg-[#F3EFE7] px-6 py-10 text-[#2C2C2C] lg:px-10">
      <div className="mx-auto max-w-6xl">
        <header className="mb-10">
          <p className="text-xs font-semibold uppercase tracking-[0.3em] text-[#B08D57]">
            Jarvis OS
          </p>

          <h1 className="mt-3 font-display text-5xl font-semibold text-[#1E3A34]">
            {greeting}
          </h1>

          <p className="mt-2 text-[#6F776B]">
            Here is what deserves your attention right now.
          </p>
        </header>

        <section className="grid gap-6 lg:grid-cols-3">
          <div className="rounded-2xl border border-[#D7D0C5] bg-[#F8F5EF] p-7 shadow-[0_12px_35px_rgba(30,58,52,0.06)] lg:col-span-2">
            <h2 className="font-display text-2xl font-semibold text-[#1E3A34]">
              Today’s focus
            </h2>

            <div className="mt-5 space-y-3">
              {isLoading ? (
                <p className="text-[#7A826E]">
                  Loading today’s calendar…
                </p>
              ) : dashboardData.todayEvents.length === 0 ? (
                <div className="rounded-xl border border-[#E1DBD1] bg-[#F3EFE7] p-4 text-[#6F776B]">
                  No scheduled events today. Your time is yours to direct.
                </div>
              ) : (
                dashboardData.todayEvents.slice(0, 3).map((event) => (
                  <div
                    key={event.id}
                    className="flex items-center gap-4 rounded-xl border border-[#E1DBD1] bg-[#F3EFE7] p-4"
                  >
                    <span className="flex min-w-[5.25rem] shrink-0 items-center justify-center whitespace-nowrap rounded-full border border-[#B08D57] px-3 py-2 text-sm text-[#7C5F33]">
                      {event.isAllDay ? "Day" : formatEventTime(event)}
                    </span>

                    <div className="min-w-0">
                      <p className="truncate font-medium">
                        {event.title}
                      </p>

                      <p className="mt-1 text-sm text-[#7A826E]">
                        {event.calendarName}
                      </p>
                    </div>
                  </div>
                ))
              )}
            </div>
          </div>

          <div className="rounded-2xl border border-[#B08D57] bg-[#E9E2D6] p-7 shadow-[0_12px_35px_rgba(176,141,87,0.10)]">
            <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[#7C5F33]">
              Jarvis recommendation
            </p>

            <h2 className="mt-3 font-display text-3xl font-semibold text-[#1E3A34]">
              {recommendation.title}
            </h2>

            <p className="mt-3 leading-7 text-[#5F665C]">
              {recommendation.message}
            </p>
          </div>
        </section>

        <section className="mt-6 grid gap-6 lg:grid-cols-2">
          <div className="rounded-2xl border border-[#D7D0C5] bg-[#F8F5EF] p-7 shadow-[0_12px_35px_rgba(30,58,52,0.06)]">
            <h2 className="font-display text-2xl font-semibold text-[#1E3A34]">
              Projects
            </h2>

            <div className="mt-5 space-y-5">
              {projects.map((project) => (
                <div key={project.name}>
                  <div className="mb-2 flex justify-between text-sm">
                    <span>{project.name}</span>
                    <span className="text-[#6F776B]">
                      {project.progress}%
                    </span>
                  </div>

                  <div className="h-2 rounded-full bg-[#D7D0C5]">
                    <div
                      className="h-2 rounded-full bg-[#B08D57]"
                      style={{ width: `${project.progress}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div className="rounded-2xl border border-[#D7D0C5] bg-[#F8F5EF] p-7 shadow-[0_12px_35px_rgba(30,58,52,0.06)]">
            <h2 className="font-display text-2xl font-semibold text-[#1E3A34]">
              Mission control
            </h2>

            <div className="mt-5 grid grid-cols-2 gap-4">
              {[
                {
                  value: dashboardData.todayEvents.length,
                  label: "Events today",
                },
                {
                  value: dashboardData.upcomingEvents.length,
                  label: "Next 7 days",
                },
                {
                  value: dashboardData.calendarCount,
                  label: "Active calendars",
                },
                {
                  value: connectionErrors.length,
                  label: "Connection alerts",
                },
              ].map((item) => (
                <div
                  key={item.label}
                  className="rounded-xl border border-[#E1DBD1] bg-[#F3EFE7] p-4"
                >
                  <p className="font-display text-3xl font-semibold text-[#1E3A34]">
                    {isLoading ? "—" : item.value}
                  </p>

                  <p className="mt-1 text-sm text-[#6F776B]">
                    {item.label}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>
      </div>
    </main>
  );
}
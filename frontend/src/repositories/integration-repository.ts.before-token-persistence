import { prisma } from "@/lib/db";
import {
  CalendarAccessRole,
  IntegrationProvider,
  IntegrationStatus,
} from "@/generated/prisma/client";

export interface UpsertGoogleIntegrationInput {
  userId: string;
  providerAccountId: string;
  email: string;
  displayName: string | null;
  encryptedCredentialPayload: string;
}


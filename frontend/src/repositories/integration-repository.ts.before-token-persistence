export async function upsertAppleCalendar(
  input: UpsertAppleCalendarInput,
) {
  return prisma.externalCalendar.upsert({
    where: {
      integrationId_externalId: {
        integrationId: input.integrationId,
        externalId: input.externalId,
      },
    },
    update: {
      name: input.name,
      description: input.description,
      timeZone: input.timeZone,
      providerColor: input.providerColor,
      accessRole: input.isReadOnly
        ? CalendarAccessRole.READER
        : CalendarAccessRole.WRITER,
      isPrimary: false,
      isReadOnly: input.isReadOnly,
      lastError: null,
    },
    create: {
      integrationId: input.integrationId,
      userId: input.userId,
      externalId: input.externalId,
      name: input.name,
      description: input.description,
      timeZone: input.timeZone,
      providerColor: input.providerColor,
      accessRole: input.isReadOnly
        ? CalendarAccessRole.READER
        : CalendarAccessRole.WRITER,
      isPrimary: false,
      isReadOnly: input.isReadOnly,
    },
  });
}

export async function markIntegrationError(
  integrationId: string,
  message: string,
) {
  return prisma.integration.update({
    where: {
      id: integrationId,
    },
    data: {
      status: IntegrationStatus.ERROR,
      lastError: message,
    },
  });
}
export async function setCalendarEnabled(
  calendarId: string,
  isEnabled: boolean,
) {
  return prisma.externalCalendar.update({
    where: {
      id: calendarId,
    },
    data: {
      isEnabled,
    },
  });
}